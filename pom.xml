<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.dantinkakkar</groupId>
    <artifactId>shady</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Shady - JVM Linkage Hazard Detection</name>
    <description>A Java agent that detects latent JVM method linkage hazards</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <asm.version>9.6</asm.version>
        <junit.version>5.11.4</junit.version>
        <spring-boot.version>3.4.4</spring-boot.version>
        <netty-codec-http.version>4.1.125.Final</netty-codec-http.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Reproduce the dependency management involved in the original mismatch. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ASM for bytecode analysis -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <version>${asm.version}</version>
        </dependency>

        <!-- JUnit 5 for testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          Regression fixture: Boot 3.4.4 manages netty-codec at 4.1.119.Final, while the
          direct override leaves netty-codec-http at 4.1.125.Final.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
            <version>${netty-codec-http.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          Test-only reproductions of linkage failures reported by open-source projects. Each pair
          deliberately combines a caller with an incompatible runtime artifact.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>6.1.10.RELEASE</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>3.5.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.17.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.20.0</version>
            <scope>test</scope>
        </dependency>

        <!-- 2025 regression: Dagger was compiled against Guava's narrower return type. -->
        <dependency>
            <groupId>com.google.dagger</groupId>
            <artifactId>dagger-spi</artifactId>
            <version>2.56.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.1.2-jre</version>
            <scope>test</scope>
        </dependency>

        <!-- 2025 regression: Fabric8 5.12.2 calls SnakeYAML's removed no-arg constructor. -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-client</artifactId>
            <version>5.12.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
            <scope>test</scope>
        </dependency>

        <!-- 2025 regression: springdoc calls a constructor removed by Spring Framework 6.2. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
            <version>2.5.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>6.2.8</version>
            <scope>test</scope>
        </dependency>

        <!--
          2026 regression (logback/SLF4J): logback-classic 1.5.x was compiled against SLF4J 2.x.
          Apache Flink 1.20.1 forces slf4j-api to 1.7.36, so projects that add logback-classic
          to a Flink application end up with an incompatible SLF4J API on the classpath.
          slf4j-api-1.7.36 cannot be placed directly on the test classpath without breaking the
          test process itself; it is instead downloaded via the dependency plugin (see below).
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>1.5.18</version>
            <scope>test</scope>
        </dependency>

        <!--
          2026 regression (Hibernate / Jakarta Persistence): Hibernate ORM 6.2+ targets the
          jakarta.persistence-api 3.1 API.  Jakarta EE 9.x platforms ship 3.0.x, which is missing
          the two-argument (String, Throwable cause) exception constructors that Hibernate 6.6
          calls inside ExceptionConverterImpl.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.6.13.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.0.0</version>
            <scope>test</scope>
        </dependency>

        <!--
          2026 regression (Spring Security / Spring Expression): Spring Security 6.4 calls
          BeanReference.getName() which was added to SpEL in Spring Framework 6.2.  A project
          that pins spring-expression at 6.1.x (e.g. via an enforced Spring Boot 3.2.x platform)
          while pulling in spring-security-core 6.4.x hits a NoSuchMethodError.
          spring-expression 6.1.21 cannot be placed on the live test classpath without globally
          downgrading it for the whole suite; it is downloaded by the plugin below instead.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <version>6.4.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <!-- Build agent JAR with manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>com.github.dantinkakkar.shady.ShadyAgent</Premain-Class>
                            <Can-Retransform-Classes>true</Can-Retransform-Classes>
                            <Can-Redefine-Classes>true</Can-Redefine-Classes>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Shade ASM into agent JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.ow2.asm:*</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.objectweb.asm</pattern>
                                    <shadedPattern>com.github.dantinkakkar.shady.asm</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire for JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <argLine>-javaagent:${project.build.directory}/${project.build.finalName}.jar</argLine>
                    <systemPropertyVariables>
                        <shady.fixture.jar.dir>${project.build.directory}/fixture-jars</shady.fixture.jar.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
              Pre-fetch versioned JARs that are used as isolated regression fixtures but cannot
              be placed on the live test classpath without causing version conflicts or breaking
              the test process itself (e.g. downgrading SLF4J from 2.x would crash logback).
              The tests locate these JARs via the shady.fixture.jar.dir system property.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-regression-fixture-jars</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <!-- SLF4J 1.7.36 (Flink-era; incompatible with logback 1.5.x) -->
                                <artifactItem>
                                    <groupId>org.slf4j</groupId>
                                    <artifactId>slf4j-api</artifactId>
                                    <version>1.7.36</version>
                                    <outputDirectory>${project.build.directory}/fixture-jars</outputDirectory>
                                </artifactItem>
                                <!-- Spring Expression 6.1.21 (missing BeanReference.getName) -->
                                <artifactItem>
                                    <groupId>org.springframework</groupId>
                                    <artifactId>spring-expression</artifactId>
                                    <version>6.1.21</version>
                                    <outputDirectory>${project.build.directory}/fixture-jars</outputDirectory>
                                </artifactItem>
                                <!-- Spring Core 6.1.21 (missing PropertyPlaceholderHelper ctor) -->
                                <artifactItem>
                                    <groupId>org.springframework</groupId>
                                    <artifactId>spring-core</artifactId>
                                    <version>6.1.21</version>
                                    <outputDirectory>${project.build.directory}/fixture-jars</outputDirectory>
                                </artifactItem>
                                <!-- Jackson Databind 2.18.3 (calls BufferRecycler.releaseToPool) -->
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-databind</artifactId>
                                    <version>2.18.3</version>
                                    <outputDirectory>${project.build.directory}/fixture-jars</outputDirectory>
                                </artifactItem>
                                <!-- Jackson Core 2.15.4 (lacks releaseToPool; managed by SB 3.2.x) -->
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-core</artifactId>
                                    <version>2.15.4</version>
                                    <outputDirectory>${project.build.directory}/fixture-jars</outputDirectory>
                                </artifactItem>
                                <!-- Jackson Annotations 2.15.4 (supporting jar for Jackson scan) -->
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-annotations</artifactId>
                                    <version>2.15.4</version>
                                    <outputDirectory>${project.build.directory}/fixture-jars</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
